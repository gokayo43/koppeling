{
  "$schema": "https://raw.githubusercontent.com/oxc-project/oxc/main/npm/oxlint/configuration_schema.json",
  "extends": ["./node_modules/@gokayo43/dev-config/oxlint.base.json"],
  "env": {
    "node": true,
    "es2024": true
  },
  "jsPlugins": ["eslint-plugin-boundaries"],
  "settings": {
    "import/resolver": {
      "typescript": {
        "project": "./tsconfig.json"
      }
    },
    "boundaries/elements": [
      {
        "type": "adapters",
        "pattern": "src/adapters"
      },
      {
        "type": "core",
        "pattern": "src"
      },
      {
        "type": "build",
        "pattern": "bin"
      },
      {
        "type": "tests",
        "pattern": "tests"
      }
    ]
  },
  "rules": {
    "boundaries/no-unknown-dependencies": "error",
    "boundaries/dependencies": [
      "error",
      {
        "default": "allow",
        "policies": [
          {
            "from": {
              "element": {
                "type": "core"
              }
            },
            "disallow": [
              {
                "to": {
                  "element": {
                    "type": "adapters"
                  }
                }
              }
            ],
            "message": "the door reads a catalogue and knows no program; only the public entry re-exports the adapters"
          }
        ]
      }
    ]
  },
  "overrides": [
    {
      "files": ["src/index.ts"],
      "rules": {
        "boundaries/dependencies": "off"
      }
    }
  ],
  "ignorePatterns": ["node_modules/**", "dist/**", "coverage/**"]
}
