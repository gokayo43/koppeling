{
  "name": "project-template-api",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/app.ts",
    "./*": "./src/*"
  },
  "scripts": {
    "dev": "bun --watch src/main.ts",
    "start": "bun src/main.ts",
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "bun run src/db/migrate.ts"
  }
}
