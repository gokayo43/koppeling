# The app is built INSIDE this image: `docker compose up -d` without a rebuild
# deploys nothing. Pinned by `bun run setup` to the Bun that produced bun.lock.
ARG BUN_VERSION=latest

FROM oven/bun:${BUN_VERSION} AS deps
WORKDIR /app
COPY package.json bun.lock bunfig.toml ./
COPY apps/api/package.json apps/api/
COPY apps/web/package.json apps/web/
# scaffold:worker
COPY apps/worker/package.json apps/worker/
# scaffold:worker
RUN bun install --frozen-lockfile
COPY . .

FROM deps AS build
# Which environment this bundle is built for — the file holding its origins,
# named by compose, which cannot hand a build the env_file its services read.
# Vite inlines import.meta.env at build time, so the API origin is baked in
# here; it is spelled VITE_ for this one command and nowhere else, because a key
# under that name in a file a checkout loads is an origin vite hands a
# developer's browser (apps/web/src/lib/api-origin.ts).
#
# The one line is read, not sourced: `. file` hands the shell a file to EXECUTE,
# and scripts/stack.sh refuses that for the same reason on .env. Nothing here
# takes quotes off, so the value is the line — scripts/env-wiring.test.ts holds
# the file to that shape.
ARG ORIGINS_ENV=deploy.env
RUN PUBLIC_API_URL="$(grep -m1 '^PUBLIC_API_URL=' "./${ORIGINS_ENV}" | cut -d= -f2-)" \
  && VITE_API_URL="${PUBLIC_API_URL:?${ORIGINS_ENV} declares no PUBLIC_API_URL}" \
     bun run --cwd apps/web build

FROM oven/bun:${BUN_VERSION} AS runtime
WORKDIR /app
# --chown so the unprivileged `bun` user can read the server bundle. Nitro
# bundles every server dependency into .output, so no install runs here.
COPY --from=build --chown=bun:bun /app/apps/web/.output ./.output
ENV NODE_ENV=production PORT=3000 HOST=0.0.0.0
EXPOSE 3000
USER bun
CMD ["bun", ".output/server/index.mjs"]
