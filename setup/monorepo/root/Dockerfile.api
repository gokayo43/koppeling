# The app is built INSIDE this image: `docker compose up -d` without a rebuild
# deploys nothing. Pinned by `bun run setup` to the Bun that produced bun.lock.
ARG BUN_VERSION=latest

FROM oven/bun:${BUN_VERSION} AS deps
WORKDIR /app
COPY package.json bun.lock bunfig.toml ./
COPY apps/api/package.json apps/api/
COPY apps/web/package.json apps/web/
# scaffold:worker
COPY apps/worker/package.json apps/worker/
# scaffold:worker
RUN bun install --frozen-lockfile
COPY . .

# The API runs from source under Bun, so `runtime` differs from `deps` only by
# dropping the workspaces it does not need. `deps` is also the migration runner:
# it is the only stage carrying drizzle-kit and the drizzle/ journal.
FROM deps AS runtime
RUN rm -rf apps/web
# HOST, because a container has to be reachable from the compose network and
# the API binds loopback without it.
ENV NODE_ENV=production PORT=3001 HOST=0.0.0.0
EXPOSE 3001
USER bun
CMD ["bun", "run", "--cwd", "apps/api", "start"]
