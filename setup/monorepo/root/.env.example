# Copy to .env and fill in. .env is gitignored; the committed copy is .env.enc,
# which is this file's real counterpart age-encrypted (see README, "Secrets").

# --- compose ---
POSTGRES_PASSWORD=
WEB_PORT=5180
API_PORT=5181
POSTGRES_PORT=5435
REDIS_PORT=6381

# --- tooling ---
# Turborepo reports anonymous usage counts unless this is set. Bun loads this
# file for `bun run`, and turbo is that command's child, so setting it here is
# what turns it off for every lane the graph runs. CI sets it in the workflow.
TURBO_TELEMETRY_DISABLED=1

# --- app ---
# The dev stack's Postgres and Redis as reached from the host — the same
# password as above, percent-encoded (or generated URL-safe: openssl rand -hex
# 32), and the ports above. Containers build their own from the
# compose file; these are what `bun run dev` and a worktree's derived world use.
DATABASE_URL=postgres://project_template:<POSTGRES_PASSWORD>@127.0.0.1:5435/project_template
REDIS_URL=redis://127.0.0.1:6381
# The two origins this run is reachable at, and they describe one environment
# together: SITE_URL is where the browser is — the API's CORS allowlist and
# Better Auth's trusted origin — and PUBLIC_API_URL is where the API answers,
# which the web image bakes into the browser bundle and the API reads as the
# issuer Better Auth mints URLs from. An origin each, and nothing more: every
# client appends its own path.
#
# What stands here is a checkout's own pair and nothing else's, so
# `cp .env.example .env` is a working dev environment, and SITE_URL's port is
# also the port `bun run dev` binds — one number, so the browser cannot arrive
# somewhere the app does not answer; PUBLIC_API_URL matches
# the fallback in apps/web/src/lib/api-origin.ts, which is what dev's browser
# bundle uses. The pair a deployment answers at lives in deploy.env, which only
# the containers read, and `scripts/preview.sh` writes a preview its own — this
# box is a deploy target as well as a checkout, so one file holding both is a
# dev server serving the deployed origins or a deployment serving loopback.
SITE_URL=http://127.0.0.1:5180
PUBLIC_API_URL=http://127.0.0.1:3001
# No VITE_API_URL: dev's origin is api-origin.ts's own default, and the name
# above is not one vite would hand a developer's browser.
# openssl rand -base64 32
BETTER_AUTH_SECRET=

# --- observability (optional; unset means nothing is sent) ---
SENTRY_DSN=
VITE_SENTRY_DSN=
VITE_POSTHOG_KEY=
VITE_POSTHOG_HOST=https://eu.i.posthog.com

# --- backups (scripts/backup.sh, scripts/restore-drill.sh; not read by the app) ---
# Public half of the age keypair, which scripts/backup.sh encrypts to.
BACKUP_AGE_RECIPIENT=
# Private half, which scripts/restore-drill.sh decrypts with. It is on this box
# because the drill runs unattended; what that protects and what it does not is
# README, "Backups". ~/.config/age/backup.key, mode 600, is the fleet's path.
BACKUP_AGE_KEY=/home/claude/.config/age/backup.key
BACKUP_R2_BUCKET=
BACKUP_R2_ENDPOINT=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
