[Unit]
Description=Report the failure of %i to the watchdog

[Service]
Type=oneshot
# %i is the failed job's slug, which its OnFailure= line spells in full — the
# same slug its heartbeat uses, since the watchdog knows no others. Which unit
# actually failed is systemd's to say: it puts the name in MONITOR_UNIT and
# expands it here (measured on systemd 255). Before 251 there is no such
# variable and the body is simply absent, which costs the alert a line and
# nothing more — the slug already names the job.
ExecStart=/opt/project-template/scripts/notify.sh failure %i ${MONITOR_UNIT}
