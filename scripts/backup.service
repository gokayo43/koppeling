[Unit]
Description=project-template nightly Postgres backup
After=docker.service
Requires=docker.service
# The failure half of "did the nightly run". ExecStartPost= below is the
# success half, and both name the same slug, because the watchdog knows a job by
# one name and answers 404 to any other. Reporting lives here rather than in the
# script for one reason: a heartbeat means THE SCHEDULED RUN happened, and only
# systemd knows whether a run was the scheduled one.
OnFailure=project-template-notify-failure@project-template-backup.service

[Service]
Type=oneshot
ExecStart=/opt/project-template/scripts/backup.sh
# Measured on systemd 255: this runs only when ExecStart exited 0, so a night
# with no backup sends no heartbeat and the watchdog notices the silence.
ExecStartPost=/opt/project-template/scripts/notify.sh heartbeat project-template-backup
# Backups are best-effort ops work; don't thrash if docker is mid-restart.
TimeoutStartSec=900
