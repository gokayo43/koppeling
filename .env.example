# Copy to .env and fill in. .env is gitignored; the committed copy is .env.enc,
# which is this file's real counterpart age-encrypted (see README, "Secrets").

# --- compose ---
POSTGRES_PASSWORD=
WEB_PORT=5180
POSTGRES_PORT=5435

# --- app ---
# The dev stack's Postgres as reached from the host — the same password as
# above, percent-encoded (or generated URL-safe: openssl rand -hex 32), and the
# port above. Containers build their own URL from the compose
# file; this one is what `bun run dev` and a worktree's derived database use.
DATABASE_URL=postgres://project_template:<POSTGRES_PASSWORD>@127.0.0.1:5435/project_template
# Where the browser is, and this checkout's own — `cp .env.example .env` is a
# working dev environment. Better Auth reads `Secure` off the scheme, so a
# deployed origin standing here is a session cookie the browser throws away over
# plaintext: sign-in answers 200, the row exists, and the app renders signed
# out. The origin a deployment runs at is in deploy.env, which only the
# containers read; scripts/env-wiring.test.ts holds both to what serves them.
#
# The port here is also the port `bun run dev` binds — one number, so the
# browser cannot arrive somewhere the app does not answer.
SITE_URL=http://127.0.0.1:5180
# openssl rand -base64 32
BETTER_AUTH_SECRET=

# --- observability (optional; unset means nothing is sent) ---
SENTRY_DSN=
VITE_SENTRY_DSN=
VITE_POSTHOG_KEY=
VITE_POSTHOG_HOST=https://eu.i.posthog.com

# --- backups (scripts/backup.sh, scripts/restore-drill.sh; not read by the app) ---
# Public half of the age keypair, which scripts/backup.sh encrypts to.
BACKUP_AGE_RECIPIENT=
# Private half, which scripts/restore-drill.sh decrypts with. It is on this box
# because the drill runs unattended; what that protects and what it does not is
# README, "Backups". ~/.config/age/backup.key, mode 600, is the fleet's path.
BACKUP_AGE_KEY=/home/claude/.config/age/backup.key
BACKUP_R2_BUCKET=
BACKUP_R2_ENDPOINT=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# How old the newest archive may be before the drill calls the backups stopped.
# Nightly, plus a night's slack; the drill itself runs weekly.
BACKUP_MAX_AGE_HOURS=36

# --- watchdog (optional; either one unset means nothing is sent) ---
# Where the systemd units report the backup and the drill: a heartbeat after a
# run that exited 0, and a failure POST when one did not. The scripts themselves
# know nothing about this — README, "Backups", says why.
HEARTBEAT_URL=
HEARTBEAT_TOKEN=
